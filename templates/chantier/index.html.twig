{% extends 'base.html.twig' %}

{% block title %}Chantiers — Mini-Gestionnaire de Chantiers{% endblock %}

{% block body %}
<main class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-8">
        <h1 class="text-2xl font-semibold tracking-tight">Chantiers</h1>
        <p class="mt-1 text-sm text-slate-600">
            {{ chantiers|length }} chantier(s) enregistré(s), du plus récent au plus ancien.
        </p>
    </header>

    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
            <thead class="bg-slate-100 text-xs uppercase tracking-wide text-slate-600">
                <tr>
                    <th scope="col" class="px-4 py-3 font-semibold">Nom</th>
                    <th scope="col" class="px-4 py-3 font-semibold">Adresse</th>
                    <th scope="col" class="px-4 py-3 font-semibold">Date de début</th>
                    <th scope="col" class="px-4 py-3 font-semibold">Statut</th>
                    <th scope="col" class="px-4 py-3 font-semibold">Équipements</th>
                    <th scope="col" class="px-4 py-3 font-semibold">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                {% for chantier in chantiers %}
                    <tr data-chantier-row data-chantier-id="{{ chantier.id }}" class="align-top">
                        <td class="px-4 py-3 font-medium text-slate-900">{{ chantier.nom }}</td>
                        <td class="px-4 py-3 text-slate-700">{{ chantier.adresse }}</td>
                        <td class="whitespace-nowrap px-4 py-3 text-slate-700">{{ chantier.dateDebut|date('d/m/Y') }}</td>
                        <td class="px-4 py-3" aria-live="polite">
                            <span class="{{ chantier.statut.badgeClass }}" data-statut-badge>{{ chantier.statut.label }}</span>
                        </td>
                        <td class="px-4 py-3 text-slate-700">
                            <ul class="space-y-1">
                                {% for equipement in chantier.equipements %}
                                    <li>{{ equipement.nom }} <span class="text-slate-500">({{ equipement.quantite }} en stock)</span></li>
                                {% else %}
                                    <li class="text-slate-400">Aucun équipement</li>
                                {% endfor %}
                            </ul>
                        </td>
                        <td class="px-4 py-3">
                            {% if not chantier.estTermine %}
                                <button type="button"
                                        class="whitespace-nowrap rounded-md border border-green-600 px-3 py-1.5 text-sm font-medium text-green-700 hover:bg-green-50 disabled:cursor-not-allowed disabled:opacity-50"
                                        data-terminer-btn
                                        data-url="{{ path('app_chantier_terminer', {id: chantier.id}) }}"
                                        data-csrf="{{ csrf_token('terminer_chantier_' ~ chantier.id) }}">
                                    Marquer comme terminé
                                </button>
                                <p class="mt-1 hidden text-sm text-red-600" data-erreur role="alert"></p>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-4 py-8 text-center text-slate-500">Aucun chantier enregistré.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if chantierDemonstration %}
        {% set urlTermine = path('app_chantier_terminer', {id: chantierDemonstration.id}) %}
        {% set jetonTermine = csrf_token('terminer_chantier_' ~ chantierDemonstration.id) %}

        <details class="mt-8 rounded-lg border border-slate-200 bg-white p-4 shadow-sm" data-simulation>
            <summary class="cursor-pointer text-sm font-semibold">Démonstration de la gestion d'erreurs</summary>

            <p class="mt-2 text-sm text-slate-600">
                Chaque bouton rejoue volontairement un échec sur le chantier déjà terminé.
                Aucune donnée n'est modifiée.
            </p>

            <div class="mt-3 flex flex-wrap gap-2">
                <button type="button" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50"
                        data-simulation-btn data-url="{{ urlTermine }}" data-csrf="jeton-invalide">Token invalide · 403</button>
                <button type="button" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50"
                        data-simulation-btn data-url="{{ path('app_chantier_terminer', {id: 0}) }}" data-csrf="{{ jetonTermine }}">Chantier inexistant · 404</button>
                <button type="button" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50"
                        data-simulation-btn data-url="{{ urlTermine }}" data-csrf="{{ jetonTermine }}">Déjà terminé · 409</button>
                <button type="button" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50"
                        data-simulation-btn data-url="{{ urlTermine }}" data-csrf="{{ jetonTermine }}" data-delai="1">Délai dépassé</button>
            </div>

            <p class="mt-3 hidden text-sm text-red-600" data-erreur role="alert"></p>
        </details>
    {% endif %}
</main>
{% endblock %}

{% block javascripts %}
    <script src="/js/chantier-status.js" defer></script>
{% endblock %}
